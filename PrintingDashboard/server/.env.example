# Copy to ".env" on the shop PC.

# Port the backend listens on (frontend defaults to expecting 4000).
PORT=4000

# The HP DesignJet T210's IP address on the LAN. Leave blank to run in
# simulation mode (mock ink levels, no real printing) for development.
PRINTER_IP=

# SNMP community string (default "public" on most HP DesignJets).
SNMP_COMMUNITY=public

# The deployed Apps Script web-app URL (same /exec URL the frontend uses).
# Used to fetch the uploaded artwork file from Drive for printing.
SHEET_URL=
