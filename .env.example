# Required for staff sign-in. Use a long private password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
STAFF_USERNAME=workshop
STAFF_PASSWORD=
PORT=3000

# Frontend backend selection. Prefer VITE_GOOGLE_SCRIPT_URL for GitHub Pages.
VITE_GOOGLE_SCRIPT_URL=
VITE_API_BASE_URL=

# Automatic Google Sheets recording (see integrations/README.md).
SHEETS_WEBHOOK_URL=
SHEETS_SHARED_SECRET=

# Set true when serving the application over HTTPS.
COOKIE_SECURE=false

# Required with NODE_ENV=production. Use the externally visible HTTPS origin.
APP_ORIGIN=
# Absolute path to an installed ClamAV clamscan executable with current signatures.
# Local development performs structural screening without malware scanning.
CLAMSCAN_PATH=

# Upload safeguards. Defaults are 10 files and 200 MiB per file.
MAX_UPLOAD_FILES=10
MAX_UPLOAD_BYTES=209715200

# Staff dashboard connected to the EXISTING live Google Sheets / Drive backend.
# This is a source-of-truth connection, not the optional mirror above.
# Keep SHEETS_WEBHOOK_URL blank when using these two settings.
WORKSHOP_GOOGLE_SCRIPT_URL=
WORKSHOP_SHARED_SECRET=

# Existing public GitHub Pages site. In Google mode, / redirects here.
PUBLIC_REQUEST_URL=
# Optional bind address (use 127.0.0.1 for local-only previews).
HOST=127.0.0.1
# Optional override; normally uses staff-dashboard/build inside this project.
STAFF_BUILD_DIR=

# Textbee: server-only credentials. Use a dedicated mandir Android phone/SIM.
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
# Persistent disk is REQUIRED, including in Google mode (SMS send journal).
DATA_DIR=
