# Required for staff sign-in. Use a long private password.
ADMIN_PASSWORD=
PORT=3000

# Frontend backend selection. Prefer VITE_GOOGLE_SCRIPT_URL for GitHub Pages.
VITE_GOOGLE_SCRIPT_URL=
VITE_API_BASE_URL=

# Automatic Google Sheets recording (see integrations/README.md).
SHEETS_WEBHOOK_URL=
SHEETS_SHARED_SECRET=

# Set true when serving the application over HTTPS.
COOKIE_SECURE=false

# Required with NODE_ENV=production. Use the externally visible HTTPS origin.
APP_ORIGIN=
# Absolute path to an installed ClamAV clamscan executable with current signatures.
# Local development performs structural screening without malware scanning.
CLAMSCAN_PATH=

# Upload safeguards. Defaults are 10 files and 200 MiB per file.
MAX_UPLOAD_FILES=10
MAX_UPLOAD_BYTES=209715200
