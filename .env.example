# Required for staff sign-in. Use a long private password.
ADMIN_PASSWORD=
PORT=3000

# Frontend backend selection. Prefer VITE_GOOGLE_SCRIPT_URL for GitHub Pages.
VITE_GOOGLE_SCRIPT_URL=
VITE_API_BASE_URL=

# Automatic Google Sheets recording (see integrations/README.md).
SHEETS_WEBHOOK_URL=
SHEETS_SHARED_SECRET=

# Email notifications. ADMIN_NOTIFICATION_EMAILS accepts a comma-separated list.
# SMTP_SECURE is normally true for port 465 and false for port 587 (STARTTLS).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Example: Delaware Mandir Workshop Tickets <tickets@example.com>
NOTIFICATION_FROM=
ADMIN_NOTIFICATION_EMAILS=demandirtickets@googlegroups.com
NOTIFICATION_REPLY_TO=demandirtickets@googlegroups.com

# Starter material-cost assumptions. Replace these with the workshop's actual costs.
COST_ESTIMATE_VERSION=materials-v1
COST_FOAM_SHEET_WIDTH_IN=48
COST_FOAM_SHEET_LENGTH_IN=96
COST_FOAM_CENTS_PER_INCH=1500
COST_FOAM_MIN_SHEET_CENTS=1500
COST_PRINT_STANDARD_CENTS_PER_SQFT=40
COST_PRINT_GLOSSY_CENTS_PER_SQFT=80
COST_PRINT_POLYPROPYLENE_CENTS_PER_SQFT=100
COST_PRINT_ADHESIVE_CENTS_PER_SQFT=125
COST_PRINT_CANVAS_CENTS_PER_SQFT=175
COST_PRINT_INK_CENTS_PER_SQFT=60

# Set true when serving the application over HTTPS.
COOKIE_SECURE=false

# Required with NODE_ENV=production. Use the externally visible HTTPS origin.
APP_ORIGIN=
# Absolute path to an installed ClamAV clamscan executable with current signatures.
# Local development performs structural screening without malware scanning.
CLAMSCAN_PATH=

# Upload safeguards. Defaults are 10 files and 200 MiB per file.
MAX_UPLOAD_FILES=10
MAX_UPLOAD_BYTES=209715200
# Close uploads that send no data for 60 seconds or run longer than 30 minutes.
UPLOAD_IDLE_TIMEOUT_MS=60000
UPLOAD_REQUEST_TIMEOUT_MS=1800000
