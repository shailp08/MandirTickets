# Staff UI is served by MandirTickets at /staff/ and uses its authenticated API.
# Leave this blank for the recommended same-origin deployment.
REACT_APP_WORKSHOP_API_URL=
REACT_APP_GOOGLE_SCRIPT_URL=
# Optional public ticket site link. Default / uses MandirTickets' configured redirect.
REACT_APP_REQUEST_SITE_URL=
PUBLIC_URL=/staff

# Legacy prototype only (not used by the new WorkshopApp):
REACT_APP_SHEET_URL=
REACT_APP_BACKEND_URL=
