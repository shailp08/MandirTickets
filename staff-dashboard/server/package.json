{
  "name": "printtrack-server",
  "version": "0.1.0",
  "private": true,
  "description": "Local backend for PrintTrack — talks to the HP DesignJet T210 (SNMP ink, IPP print) and fetches artwork from Drive via Apps Script.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@types/pdfkit": "^0.17.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "image-size": "^1.2.1",
    "ipp": "^2.0.1",
    "net-snmp": "^3.11.2",
    "pdfkit": "^0.19.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
